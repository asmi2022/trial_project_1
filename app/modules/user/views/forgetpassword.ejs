<% layout(layout_directory + "/loginlayout") -%>

<div class="wrapper fadeInDown">

    <div id="formContent">
      <!-- Tabs Titles -->
      <h2 class="active"> Forget Password </h2>
      <!-- <h2 class="inactive underlineHover">Sign Up </h2> -->
      <p class="card-text py-2">
        Enter your email address and we'll send you an email with instructions to reset your password.
      </p>
      <!-- Icon -->
      <!-- <div class="fadeIn first">
        <img src="http://danielzawadzki.com/codepen/01/icon.svg" id="icon" alt="User Icon" />
      </div> -->
  
      <!-- Login Form -->
      <form method="post" action= "<%= generate_url('user.forget_password') %>" enctype="application/x-www-form-urlencoded">
        <input type="email" id="email" class="fadeIn second" name="email" placeholder=" Enter your email">
        <!-- <input type="submit" class="fadeIn fourth" value="Log In"> -->
         <button type="submit" class="fadeIn fourth">Send Email</button>
      </form>
  
      <!-- Back to Login page -->
      <div id="formFooter">
        <a class="underlineHover" href="<%= generate_url('user.signin.page') %>">Back To Login</a>
      </div>
  
    </div>
  </div>