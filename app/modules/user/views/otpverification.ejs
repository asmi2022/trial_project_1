<% layout(layout_directory + "/loginlayout") -%>

<div class="wrapper fadeInDown">

    <div id="formContent">
      <!-- Tabs Titles -->
      <h2 class="active"> OTP VERIFICATION </h2>
      <!-- <h2 class="inactive underlineHover">Sign Up </h2> -->

      <!-- Icon -->
      <!-- <div class="fadeIn first">
        <img src="http://danielzawadzki.com/codepen/01/icon.svg" id="icon" alt="User Icon" />
      </div> -->
  
      <!-- Login Form -->
      <form method="post" action= "<%= generate_url('user.otp_verification') %>" enctype="application/x-www-form-urlencoded">
        <input type="hidden" name="id" value="<%= user._id %>">
        <input type="text" id="otp" class="fadeIn second" name="otp" placeholder=" Enter OTP">
        <!-- <input type="submit" class="fadeIn fourth" value="Log In"> -->
         <button type="submit" class="fadeIn fourth">Verify</button>
      </form>
  
      <!-- Back to Login page -->
      <div id="formFooter">
        <a class="underlineHover" href="<%= generate_url('user.signin.page') %>">Back To Login</a>
      </div>
  
    </div>
  </div>